# URL base de la REST API de WordPress (sin barra final)
# Ejemplo: https://tu-dominio.com/wp-json
# Es pública: se incrusta en el JS del sitio porque el contenido se consulta
# desde el navegador. La API debe permitir CORS desde el dominio del sitio.
WP_API_URL=https://tu-dominio.com/wp-json

# ID del formulario de Contact Form 7 (WordPress) para el formulario de contacto
# Se ve en el shortcode del plugin: [contact-form-7 id="123" ...]  →  CF7_FORM_ID=123
CF7_FORM_ID=
