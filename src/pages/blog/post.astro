---
// Plantilla única de artículo. En cPanel, public/.htaccess reescribe
// /blog/<slug> hacia esta página (la URL visible no cambia) y el artículo
// se consulta a WordPress desde el navegador. También acepta ?slug=<slug>.
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import NavBar from "@/components/ui/NavBar.astro";
import Footer from "@/components/ui/Footer.astro";
import Profile from "@/assets/profile.png";
---

<Layout
  title="Artículo · Blog de Luis Angel Gutierrez"
  description="Artículo del blog de Luis Angel Gutierrez sobre desarrollo full stack y arquitectura web."
  ogType="article"
>
  <NavBar slot="nav" />

  <article class="max-w-5xl mx-auto px-6 lg:px-10 py-16" data-blog-post>
    <div data-view="loading">
      <p class="sr-only" role="status">Cargando artículo…</p>
      <div class="h-3 w-40 rounded bg-surface-high animate-pulse mb-10"></div>
      <div class="h-3 w-32 rounded bg-surface-high animate-pulse mb-4"></div>
      <div class="h-10 w-5/6 rounded bg-surface-high animate-pulse mb-4"></div>
      <div class="h-10 w-2/3 rounded bg-surface-high animate-pulse mb-8"></div>
      <div
        class="aspect-video w-full rounded-xl bg-surface-container animate-pulse mb-12"
      >
      </div>
      <div class="space-y-3">
        <div class="h-4 w-full rounded bg-surface-high animate-pulse"></div>
        <div class="h-4 w-full rounded bg-surface-high animate-pulse"></div>
        <div class="h-4 w-4/5 rounded bg-surface-high animate-pulse"></div>
      </div>
    </div>

    <div data-view="not-found" hidden class="text-center py-20">
      <p class="font-headline text-2xl text-on-surface-variant">
        Este artículo no existe o fue movido
      </p>
      <a
        href="/blog/"
        class="inline-flex mt-6 items-center gap-2 text-sm text-primary hover:underline"
      >
        Ver todos los artículos
      </a>
    </div>

    <div data-view="error" hidden role="alert" class="text-center py-20">
      <p class="font-headline text-2xl text-on-surface-variant">
        No se pudo cargar el artículo
      </p>
      <p class="text-sm text-on-surface-variant mt-2">
        Revisa tu conexión e intenta recargar la página.
      </p>
      <a
        href="/blog/"
        class="inline-flex mt-6 items-center gap-2 text-sm text-on-surface-variant hover:text-on-surface transition-colors"
      >
        Volver al blog
      </a>
    </div>

    <div data-view="ready" hidden>
      <!-- Breadcrumb -->
      <nav
        class="flex items-center gap-2 text-xs text-on-surface-variant mb-10"
        aria-label="breadcrumb"
      >
        <a href="/" class="hover:text-on-surface transition-colors">Inicio</a>
        <span>/</span>
        <a href="/blog/" class="hover:text-on-surface transition-colors">Blog</a>
        <span>/</span>
        <span
          data-field="breadcrumb"
          class="text-on-surface truncate max-w-[200px]"
          aria-current="page"></span>
      </nav>

      <!-- Cabecera del artículo -->
      <header class="mb-10">
        <p
          data-field="date"
          class="font-mono text-xs text-primary uppercase tracking-widest mb-4"
        >
        </p>

        <h1
          data-field="title"
          class="font-headline text-4xl lg:text-5xl font-bold text-on-surface leading-tight mb-6"
        >
        </h1>

        <p
          data-field="excerpt"
          class="text-lg text-on-surface-variant font-light leading-relaxed"
        >
        </p>

        <!-- Separador -->
        <div class="mt-8 flex items-center gap-4">
          <span
            class="block flex-1 h-px"
            style="background: color-mix(in srgb, var(--outline-variant) 30%, transparent);"
          ></span>
          <span
            class="font-mono text-2xs text-on-surface-variant uppercase tracking-wider"
            >Luis Angel Gutierrez</span
          >
          <span
            class="block flex-1 h-px"
            style="background: color-mix(in srgb, var(--outline-variant) 30%, transparent);"
          ></span>
        </div>
      </header>

      <!-- Imagen destacada -->
      <img
        data-field="image"
        alt=""
        decoding="async"
        fetchpriority="high"
        class="mb-12 rounded-xl aspect-video w-full object-cover"
      />

      <!-- Contenido del post (HTML de WordPress) -->
      <div
        data-field="content"
        class="prose-content leading-relaxed text-on-surface/90"
      >
      </div>

      <!-- Pie del artículo -->
      <footer
        class="mt-16 pt-8"
        style="border-top: 1px solid color-mix(in srgb, var(--outline-variant) 30%, transparent);"
      >
        <div
          class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6"
        >
          <!-- Autor -->
          <div class="flex items-center gap-4">
            <div
              class="w-12 h-12 rounded-full bg-surface-container overflow-hidden flex-shrink-0"
            >
              <Picture
                src={Profile}
                alt="Luis Angel Gutierrez"
                class="w-full h-full object-cover"
                loading="lazy"
                formats={["avif", "webp"]}
              />
            </div>
            <div>
              <p class="text-sm font-semibold text-on-surface">
                Luis Angel Gutierrez
              </p>
              <p class="text-xs text-on-surface-variant">
                Full Stack Developer
              </p>
            </div>
          </div>

          <!-- Volver al blog -->
          <a
            href="/blog/"
            class="inline-flex items-center gap-2 text-sm text-on-surface-variant hover:text-on-surface transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
            Volver al blog
          </a>
        </div>
      </footer>
    </div>
  </article>

  <Footer slot="footer" />
</Layout>

<script>
  import { applyImage, getField, setField, showView } from "@/lib/dom";
  import { buildMetaDescription } from "@/lib/seo";
  import {
    formatPostDate,
    getFeaturedImage,
    getPostBySlug,
    getPostUrl,
    safeDecode,
    stripHtml,
    type WPPost,
  } from "@/lib/wordpress";

  const root = document.querySelector<HTMLElement>("[data-blog-post]");
  if (root) {
    renderPost(root).catch((error) => {
      console.error(error);
      setNoIndex();
      showView(root, "error");
    });
  }

  /** Slug desde /blog/<slug> (reescrito por .htaccess) o desde ?slug=. */
  function readSlug(): string | null {
    const fromQuery = new URLSearchParams(window.location.search).get("slug");
    if (fromQuery?.trim()) return fromQuery.trim();

    const match = window.location.pathname.match(/^\/blog\/([^/]+)\/?$/);
    if (!match?.[1] || match[1] === "post") return null;
    return safeDecode(match[1]);
  }

  function setMeta(selector: string, value: string): void {
    document.querySelector(selector)?.setAttribute("content", value);
  }

  function setNoIndex(): void {
    setMeta('meta[name="robots"]', "noindex,follow");
  }

  function updateMeta(post: WPPost, title: string, excerpt: string): void {
    const pageTitle = `${title} · Blog de Luis Angel Gutierrez`;
    const description = buildMetaDescription(
      excerpt,
      `Lee ${title} en el blog de Luis Angel Gutierrez sobre desarrollo full stack y arquitectura web.`,
    );
    // El canonical generado en build ya apunta al dominio público del sitio.
    const canonical = document.querySelector('link[rel="canonical"]');
    const url = new URL(
      getPostUrl(post),
      canonical?.getAttribute("href") ?? window.location.origin,
    ).href;
    const image = getFeaturedImage(post)?.src;

    document.title = pageTitle;
    canonical?.setAttribute("href", url);
    setMeta('meta[name="description"]', description);
    setMeta('meta[property="og:url"]', url);
    setMeta('meta[property="og:title"]', pageTitle);
    setMeta('meta[property="og:description"]', description);
    setMeta('meta[property="og:image:alt"]', pageTitle);
    setMeta('meta[name="twitter:title"]', pageTitle);
    setMeta('meta[name="twitter:description"]', description);
    if (image) {
      setMeta('meta[property="og:image"]', image);
      setMeta('meta[name="twitter:image"]', image);
    }

    // Si se llegó por ?slug=, se muestra la URL pública del artículo.
    if (window.location.pathname !== getPostUrl(post)) {
      history.replaceState(history.state, "", getPostUrl(post));
    }
  }

  async function renderPost(root: HTMLElement) {
    const slug = readSlug();
    if (!slug) {
      setNoIndex();
      showView(root, "not-found");
      return;
    }

    const post = await getPostBySlug(slug);
    if (!post) {
      setNoIndex();
      showView(root, "not-found");
      return;
    }

    const title = stripHtml(post.title?.rendered ?? "") || "Artículo";
    const excerpt = stripHtml(post.excerpt?.rendered ?? "");

    setField(root, "breadcrumb", title);
    setField(root, "date", formatPostDate(post.date));
    setField(root, "title", title);
    if (excerpt) setField(root, "excerpt", excerpt);
    else getField(root, "excerpt")?.remove();

    const content = getField(root, "content");
    // Contenido propio publicado desde el WordPress del sitio.
    if (content) content.innerHTML = post.content?.rendered ?? "";

    const image = getFeaturedImage(post);
    const img = getField<HTMLImageElement>(root, "image");
    if (image && img) {
      applyImage(img, image, title, "(min-width: 1024px) 960px, 100vw");
    } else {
      img?.remove();
    }

    updateMeta(post, title, excerpt);
    showView(root, "ready");
  }
</script>

<style>
  @reference "@/styles/global.css";

  .prose-content :global(h2) {
    @apply font-headline text-2xl font-semibold text-on-surface mt-10 mb-4;
  }
  .prose-content :global(h3) {
    @apply font-headline text-xl font-semibold text-on-surface mt-8 mb-3;
  }
  .prose-content :global(p) {
    @apply text-base text-on-surface/80 mb-5 leading-relaxed;
  }
  .prose-content :global(a) {
    @apply text-primary underline underline-offset-2 hover:text-primary/80 transition-colors;
  }
  .prose-content :global(ul) {
    @apply list-disc list-outside pl-6 mb-5 space-y-1 text-on-surface/80;
  }
  .prose-content :global(ol) {
    @apply list-decimal list-outside pl-6 mb-5 space-y-1 text-on-surface/80;
  }
  .prose-content :global(li > p) {
    @apply mb-0;
  }
  .prose-content :global(blockquote) {
    @apply border-l-4 border-primary pl-5 my-6 italic text-on-surface-variant;
  }
  .prose-content :global(pre) {
    @apply font-mono text-sm bg-surface-container text-on-surface p-5 rounded-xl overflow-x-auto my-6;
  }
  .prose-content :global(code:not(pre code)) {
    @apply font-mono text-sm text-primary bg-surface-container px-1.5 py-0.5 rounded;
  }
  .prose-content :global(img) {
    @apply rounded-xl my-8 w-full;
  }
  .prose-content :global(hr) {
    @apply my-10;
    border-color: color-mix(in srgb, var(--outline-variant) 30%, transparent);
  }
  .prose-content :global(strong) {
    @apply font-semibold text-on-surface;
  }
</style>
