---
import BlogList from "@/components/BlogList.astro";
import NavBar from "@/components/ui/NavBar.astro";
import Footer from "@/components/ui/Footer.astro";
import Layout from "@/layouts/Layout.astro";
import { getAllPosts, type WPPost } from "@/lib/wordpress";

interface PageProps {
  posts: WPPost[];
  currentPage: number;
  totalPages: number;
}

export async function getStaticPaths() {
  const postsPerPage = 9;
  const allPosts: WPPost[] = await getAllPosts().catch(() => []);
  const totalPages = Math.ceil(allPosts.length / postsPerPage);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const currentPage = index + 2;
    const firstPost = (currentPage - 1) * postsPerPage;

    return {
      params: { page: String(currentPage) },
      props: {
        posts: allPosts.slice(firstPost, firstPost + postsPerPage),
        currentPage,
        totalPages,
      } satisfies PageProps,
    };
  });
}

const { posts, currentPage, totalPages } = Astro.props as PageProps;
---

<Layout
  title={`Página ${currentPage} · Blog de Luis Angel Gutierrez`}
  description="Blog de Luis Angel Gutierrez con artículos sobre desarrollo full stack, arquitectura web, JavaScript, React, Node.js y buenas prácticas de software."
>
  <NavBar slot="nav" />

  <section
    class="pt-16 pb-12"
    style="border-bottom: 1px solid color-mix(in srgb, var(--outline-variant) 30%, transparent);"
  >
    <div class="max-w-content mx-auto px-6 lg:px-10 py-16">
      <div class="flex items-center gap-4 mb-6">
        <span class="block w-8 h-px bg-primary"></span>
        <span class="font-mono text-xs text-primary uppercase tracking-widest"
          >Blog</span
        >
      </div>
      <h1
        class="font-headline text-5xl lg:text-6xl font-bold text-on-surface leading-tight"
      >
        Notas sobre<br /><em class="text-primary font-normal italic"
          >desarrollo</em
        >
      </h1>
      <p class="mt-5 max-w-lg text-on-surface-variant text-lg font-light">
        Artículos sobre lo que aprendo, experimento y construyo como
        desarrollador Full Stack.
      </p>
    </div>
  </section>

  <BlogList posts={posts} currentPage={currentPage} totalPages={totalPages} />

  <Footer slot="footer" />
</Layout>
