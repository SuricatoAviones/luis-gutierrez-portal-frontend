<section id="experiencia" class="py-24 lg:py-32">
  <div class="max-w-content mx-auto px-6 lg:px-10">
    <div class="flex items-center gap-4 mb-16 reveal">
      <span class="font-mono text-2xs text-primary uppercase tracking-widest"
        >04</span
      >
      <span class="block w-8 h-px bg-primary"></span>
      <h2
        class="font-headline text-3xl lg:text-4xl font-semibold text-on-surface"
      >
        Trayectoria Profesional
      </h2>
    </div>

    <div data-experience aria-busy="true">
      <div data-view="loading">
        <p class="sr-only" role="status">Cargando experiencia…</p>
        <div class="space-y-12" aria-hidden="true">
          {
            [0, 1, 2].map(() => (
              <div class="pl-14 sm:pl-20">
                <div class="rounded-xl bg-surface-low p-6 ghost-border space-y-3">
                  <div class="h-5 w-1/2 rounded bg-surface-high animate-pulse" />
                  <div class="h-4 w-1/4 rounded bg-surface-high animate-pulse" />
                  <div class="h-4 w-full rounded bg-surface-high animate-pulse" />
                  <div class="h-4 w-5/6 rounded bg-surface-high animate-pulse" />
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <p
        data-view="empty"
        hidden
        class="rounded-lg border border-outline-variant/40 bg-surface-low px-4 py-3 text-sm text-on-surface-variant"
      >
        No hay experiencias disponibles en este momento.
      </p>

      <p
        data-view="error"
        hidden
        role="alert"
        class="rounded-lg border border-outline-variant/40 bg-surface-low px-4 py-3 text-sm text-on-surface-variant"
      >
        No se pudo cargar la experiencia. Intenta recargar la página.
      </p>

      <div data-view="ready" hidden class="relative">
        <div
          class="absolute left-4 sm:left-6 top-0 bottom-0 w-px bg-gradient-to-b from-primary via-outline-variant/30 to-transparent"
          aria-hidden="true"
        >
        </div>

        <ol class="space-y-12" data-experience-list></ol>
      </div>

      <template data-experience-template>
        <li class="relative pl-14 sm:pl-20 reveal">
          <div
            class="absolute left-0 sm:left-2 top-1.5 flex items-center justify-center"
            aria-hidden="true"
          >
            <div
              data-field="dot"
              class="w-5 h-5 rounded-full flex items-center justify-center"
            >
              <div
                data-field="dot-inner"
                class="w-2 h-2 rounded-full bg-on-primary"
              >
              </div>
            </div>
          </div>

          <article
            class="bg-surface-low rounded-xl p-6 ghost-border hover:bg-surface-highest transition-all duration-300"
          >
            <div
              class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-4"
            >
              <div>
                <h3
                  data-field="position"
                  class="font-headline text-lg font-semibold text-on-surface"
                >
                </h3>
                <div class="flex items-center gap-2 mt-1">
                  <a
                    data-field="company-link"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm font-medium text-primary hover:underline"
                  ></a>
                  <span
                    data-field="company-text"
                    class="text-sm font-medium text-primary"></span>
                </div>
              </div>

              <div class="flex-shrink-0 text-right">
                <span
                  data-field="period"
                  class="inline-flex items-center font-mono text-2xs px-3 py-1 rounded-full uppercase tracking-wider"
                >
                  <span
                    data-field="pulse"
                    class="mr-1.5 inline-block w-1.5 h-1.5 rounded-full bg-primary animate-pulse"
                    aria-hidden="true"></span>
                  <span data-field="dates"></span>
                </span>
              </div>
            </div>

            <p
              data-field="description"
              class="text-sm text-on-surface-variant leading-relaxed mb-4"
            >
            </p>

            <div
              data-field="technologies"
              class="flex flex-wrap gap-2 pt-4"
              style="border-top: 1px solid color-mix(in srgb, var(--outline-variant) 20%, transparent);"
            >
            </div>
          </article>
        </li>
      </template>

      <template data-tech-template>
        <span
          class="font-mono text-2xs text-on-surface-variant bg-surface-high px-2.5 py-1 rounded-full"
        ></span>
      </template>
    </div>
  </div>
</section>

<script>
  import { cloneTemplate, getField, setField, showView } from "@/lib/dom";
  import {
    acfText,
    formatYearMonth,
    getExperiences,
    parseTechs,
    stripHtml,
    toSafeUrl,
    type AcfValue,
    type Experience,
  } from "@/lib/wordpress";

  const root = document.querySelector<HTMLElement>("[data-experience]");
  if (root) {
    renderExperience(root).catch((error) => {
      console.error(error);
      showView(root, "error");
    });
  }

  function dateValue(value: AcfValue, fallback = 0): number {
    const trimmed = acfText(value);
    if (!trimmed || trimmed.toLowerCase() === "presente") return fallback;
    const [year, month] = trimmed.split("-").map(Number);
    if (!Number.isFinite(year)) return fallback;
    return year * 100 + (Number.isFinite(month) ? month : 0);
  }

  function createExperienceItem(
    root: HTMLElement,
    experience: Experience,
    index: number,
  ): HTMLElement {
    const item = cloneTemplate(
      root.querySelector("template[data-experience-template]"),
    );
    const acf = experience.acf ?? {};
    const title = stripHtml(experience.title?.rendered ?? "");
    const company = acfText(acf.company) || "Empresa";
    const endDate = acfText(acf.end_date) || "presente";
    const isCurrent = endDate.toLowerCase() === "presente";
    const start = formatYearMonth(acfText(acf.start_date)) || "Inicio";
    const end = isCurrent ? "Presente" : formatYearMonth(endDate) || "Actualidad";

    item.style.animationDelay = `${index * 100}ms`;
    setField(
      item,
      "position",
      acfText(acf.position) || title || "Rol en actualización",
    );
    setField(item, "dates", `${start} — ${end}`);
    setField(
      item,
      "description",
      acfText(acf.description) ||
        "Experiencia en actualización. Pronto más detalles.",
    );

    const dot = getField(item, "dot");
    if (isCurrent) {
      dot?.classList.add("bg-primary");
    } else {
      dot?.classList.add("bg-surface-container");
      dot?.style.setProperty(
        "border",
        "2px solid color-mix(in srgb, var(--outline-variant) 40%, transparent)",
      );
      getField(item, "dot-inner")?.remove();
    }

    getField(item, "period")?.classList.add(
      ...(isCurrent
        ? ["bg-primary-container", "text-on-primary-container"]
        : ["bg-surface-high", "text-on-surface-variant"]),
    );
    if (!isCurrent) getField(item, "pulse")?.remove();

    const companyUrl = toSafeUrl(acf.company_url);
    const companyLink = getField<HTMLAnchorElement>(item, "company-link");
    if (companyUrl && companyLink) {
      companyLink.href = companyUrl;
      companyLink.textContent = company;
      getField(item, "company-text")?.remove();
    } else {
      companyLink?.remove();
      setField(item, "company-text", company);
    }

    const technologies = parseTechs(acf.technologies);
    const techList = getField(item, "technologies");
    if (techList && technologies.length > 0) {
      techList.append(
        ...technologies.map((technology) => {
          const chip = cloneTemplate(
            root.querySelector("template[data-tech-template]"),
          );
          chip.textContent = technology;
          return chip;
        }),
      );
    } else {
      techList?.remove();
    }

    return item;
  }

  async function renderExperience(root: HTMLElement) {
    const experiences = await getExperiences();
    const list = root.querySelector<HTMLElement>("[data-experience-list]");
    if (experiences.length === 0 || !list) {
      showView(root, "empty");
      return;
    }

    experiences.sort((a, b) => {
      const aEnd = dateValue(a.acf?.end_date, Infinity);
      const bEnd = dateValue(b.acf?.end_date, Infinity);
      if (aEnd !== bEnd) return bEnd - aEnd;
      return dateValue(b.acf?.start_date) - dateValue(a.acf?.start_date);
    });

    list.replaceChildren(
      ...experiences.map((experience, index) =>
        createExperienceItem(root, experience, index),
      ),
    );
    showView(root, "ready");
  }
</script>
