---
import {
  formatDate,
  getExperiences,
  parseTechs,
  stripHtml,
  type Experience,
  type ExperienceFields,
} from "@/lib/wordpress";

const experiences: Experience[] = await getExperiences().catch(() => []);
---

<section id="experiencia" class="py-24 lg:py-32">
  <div class="max-w-content mx-auto px-6 lg:px-10">
    <div class="flex items-center gap-4 mb-16 reveal">
      <span class="font-mono text-2xs text-primary uppercase tracking-widest"
        >04</span
      >
      <span class="block w-8 h-px bg-primary"></span>
      <h2
        class="font-headline text-3xl lg:text-4xl font-semibold text-on-surface"
      >
        Trayectoria Profesional
      </h2>
    </div>

    {
      experiences.length > 0 ? (
        <div class="relative">
          <div
            class="absolute left-4 sm:left-6 top-0 bottom-0 w-px bg-gradient-to-b from-primary via-outline-variant/30 to-transparent"
            aria-hidden="true"
          />

          <ol class="space-y-12">
            {experiences.map((experience, index) => {
              const title = stripHtml(experience.title?.rendered ?? "");
              const acf: ExperienceFields = experience.acf ?? {};
              const position =
                acf.position?.trim() || title || "Rol en actualización";
              const company = acf.company?.trim() || "Empresa";
              const endDate = acf.end_date?.trim() || "presente";
              const isCurrent = endDate.toLowerCase() === "presente";
              const start = formatDate(acf.start_date ?? "") || "Inicio";
              const end = isCurrent
                ? "Presente"
                : formatDate(endDate) || "Actualidad";
              const technologies = parseTechs(acf.technologies ?? "");
              const companyUrl = acf.company_url?.trim();

              return (
                <li
                  class="relative pl-14 sm:pl-20 reveal"
                  style={`animation-delay: ${index * 100}ms`}
                >
                  <div
                    class="absolute left-0 sm:left-2 top-1.5 flex items-center justify-center"
                    aria-hidden="true"
                  >
                    <div
                      class={`w-5 h-5 rounded-full flex items-center justify-center ${
                        isCurrent ? "bg-primary" : "bg-surface-container"
                      }`}
                      style={
                        isCurrent
                          ? undefined
                          : "border: 2px solid color-mix(in srgb, var(--outline-variant) 40%, transparent);"
                      }
                    >
                      {isCurrent && (
                        <div class="w-2 h-2 rounded-full bg-on-primary" />
                      )}
                    </div>
                  </div>

                  <article class="bg-surface-low rounded-xl p-6 ghost-border hover:bg-surface-highest transition-all duration-300">
                    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-4">
                      <div>
                        <h3 class="font-headline text-lg font-semibold text-on-surface">
                          {position}
                        </h3>
                        <div class="flex items-center gap-2 mt-1">
                          {companyUrl && companyUrl !== "#" ? (
                            <a
                              href={companyUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-sm font-medium text-primary hover:underline"
                            >
                              {company}
                            </a>
                          ) : (
                            <span class="text-sm font-medium text-primary">
                              {company}
                            </span>
                          )}
                        </div>
                      </div>

                      <div class="flex-shrink-0 text-right">
                        <span
                          class={`inline-flex items-center font-mono text-2xs px-3 py-1 rounded-full uppercase tracking-wider ${
                            isCurrent
                              ? "bg-primary-container text-on-primary-container"
                              : "bg-surface-high text-on-surface-variant"
                          }`}
                        >
                          {isCurrent && (
                            <span
                              class="mr-1.5 inline-block w-1.5 h-1.5 rounded-full bg-primary animate-pulse"
                              aria-hidden="true"
                            />
                          )}
                          {start} — {end}
                        </span>
                      </div>
                    </div>

                    <p class="text-sm text-on-surface-variant leading-relaxed mb-4">
                      {acf.description?.trim() ||
                        "Experiencia en actualización. Pronto más detalles."}
                    </p>

                    {technologies.length > 0 && (
                      <div
                        class="flex flex-wrap gap-2 pt-4"
                        style="border-top: 1px solid color-mix(in srgb, var(--outline-variant) 20%, transparent);"
                      >
                        {technologies.map((technology) => (
                          <span class="font-mono text-2xs text-on-surface-variant bg-surface-high px-2.5 py-1 rounded-full">
                            {technology}
                          </span>
                        ))}
                      </div>
                    )}
                  </article>
                </li>
              );
            })}
          </ol>
        </div>
      ) : (
        <p class="rounded-lg border border-outline-variant/40 bg-surface-low px-4 py-3 text-sm text-on-surface-variant">
          No hay experiencias disponibles en este momento.
        </p>
      )
    }
  </div>
</section>
