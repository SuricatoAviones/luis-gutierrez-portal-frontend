<section id="habilidades" class="py-24 lg:py-32 bg-surface-container">
  <div class="max-w-content mx-auto px-6 lg:px-10">
    <div class="flex items-center gap-4 mb-16 reveal">
      <span class="font-mono text-2xs text-primary uppercase tracking-widest"
        >02</span
      >
      <span class="block w-8 h-px bg-primary"></span>
      <h2
        class="font-headline text-3xl lg:text-4xl font-semibold text-on-surface"
      >
        Habilidades
      </h2>
    </div>

    <div data-skills aria-busy="true">
      <div data-view="loading">
        <p class="sr-only" role="status">Cargando habilidades…</p>
        <div class="flex gap-2 mb-12" aria-hidden="true">
          {
            [0, 1, 2, 3].map(() => (
              <span class="h-8 w-24 rounded-full bg-surface-high animate-pulse" />
            ))
          }
        </div>
        <div
          class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3"
          aria-hidden="true"
        >
          {
            [0, 1, 2, 3, 4, 5].map((index) => (
              <div
                class:list={[
                  "h-19 rounded-xl bg-surface-low animate-pulse ghost-border",
                  index > 0 && index < 4 && "hidden md:block",
                  index >= 4 && "hidden lg:block",
                ]}
              />
            ))
          }
        </div>
      </div>

      <p
        data-view="empty"
        hidden
        class="rounded-lg border border-outline-variant/40 bg-surface-low px-4 py-3 text-sm text-on-surface-variant"
      >
        No hay habilidades disponibles en este momento.
      </p>

      <p
        data-view="error"
        hidden
        role="alert"
        class="rounded-lg border border-outline-variant/40 bg-surface-low px-4 py-3 text-sm text-on-surface-variant"
      >
        No se pudieron cargar las habilidades. Intenta recargar la página.
      </p>

      <div data-view="ready" hidden>
        <div
          class="flex flex-nowrap gap-2 mb-12 overflow-x-auto pb-2 -mx-6 pl-12 pr-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:mx-0 sm:flex-wrap sm:overflow-visible sm:p-0 reveal"
          role="tablist"
          aria-label="Categorías de habilidades"
          data-skill-tablist
        >
        </div>
        <div data-skill-panels></div>
      </div>

      <template data-skill-tab-template>
        <button
          type="button"
          role="tab"
          class="px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 bg-surface-high text-on-surface-variant hover:bg-surface-highest hover:text-on-surface"
        >
        </button>
      </template>

      <template data-skill-panel-template>
        <div
          role="tabpanel"
          class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4 -mx-6 pl-12 pr-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:mx-0 md:grid md:grid-cols-2 md:gap-4 md:overflow-visible md:p-0 lg:grid-cols-3"
        >
        </div>
      </template>

      <template data-skill-card-template>
        <div
          class="reveal group w-[calc(100%-1.5rem)] shrink-0 snap-start bg-surface-low hover:bg-surface-highest rounded-xl p-5 transition-all duration-300 ghost-border md:w-auto"
        >
          <div class="flex items-center justify-between mb-3">
            <span
              data-field="title"
              class="font-body text-sm font-medium text-on-surface"></span>
            <span data-field="level" class="font-mono text-xs text-primary"
            ></span>
          </div>
          <div
            data-field="progress"
            class="h-1 bg-outline-variant/20 rounded-full overflow-hidden"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax="100"
          >
            <div
              data-field="bar"
              class="skill-bar h-full bg-primary rounded-full origin-left scale-x-0 transition-transform duration-700"
              style="transition-timing-function: var(--ease-expo);"
            >
            </div>
          </div>
        </div>
      </template>
    </div>
  </div>
</section>

<script>
  import { cloneTemplate, getField, setField, showView } from "@/lib/dom";
  import {
    getSkills,
    groupSkillsByCategory,
    stripHtml,
    type Skill,
  } from "@/lib/wordpress";

  const root = document.querySelector<HTMLElement>("[data-skills]");
  if (root) {
    renderSkills(root).catch((error) => {
      console.error(error);
      showView(root, "error");
    });
  }

  function getLevel(skill: Skill): number {
    const level = Number(skill.acf?.level ?? 0);
    return Number.isFinite(level) ? Math.min(100, Math.max(0, level)) : 0;
  }

  function createSkillCard(
    root: HTMLElement,
    skill: Skill,
    index: number,
  ): HTMLElement {
    const card = cloneTemplate(
      root.querySelector("template[data-skill-card-template]"),
    );
    const title = stripHtml(skill.title?.rendered ?? "") || "Habilidad";
    const level = getLevel(skill);

    card.style.animationDelay = `${index * 60}ms`;
    setField(card, "title", title);
    setField(card, "level", `${level}%`);

    const progress = getField(card, "progress");
    progress?.setAttribute("aria-label", `Nivel de ${title}`);
    progress?.setAttribute("aria-valuenow", String(level));
    getField(card, "bar")?.style.setProperty("--skill-level", String(level / 100));

    return card;
  }

  async function renderSkills(root: HTMLElement) {
    const groups = groupSkillsByCategory(await getSkills());
    const tabList = root.querySelector<HTMLElement>("[data-skill-tablist]");
    const panelsContainer = root.querySelector<HTMLElement>(
      "[data-skill-panels]",
    );

    if (groups.length === 0 || !tabList || !panelsContainer) {
      showView(root, "empty");
      return;
    }

    const tabs: HTMLButtonElement[] = [];
    const panels: HTMLElement[] = [];

    groups.forEach(([category, categorySkills], index) => {
      const tab = cloneTemplate<HTMLButtonElement>(
        root.querySelector("template[data-skill-tab-template]"),
      );
      tab.id = `skill-tab-${index}`;
      tab.textContent = category;
      tab.setAttribute("aria-controls", `skill-panel-${index}`);
      tabs.push(tab);

      const panel = cloneTemplate(
        root.querySelector("template[data-skill-panel-template]"),
      );
      panel.id = `skill-panel-${index}`;
      panel.setAttribute("aria-labelledby", tab.id);
      panel.append(
        ...categorySkills.map((skill, skillIndex) =>
          createSkillCard(root, skill, skillIndex),
        ),
      );
      panels.push(panel);
    });

    tabList.replaceChildren(...tabs);
    panelsContainer.replaceChildren(...panels);
    showView(root, "ready");
    setupTabs(tabs, panels);
  }

  function setupTabs(tabs: HTMLButtonElement[], panels: HTMLElement[]) {
    const animatedBars = new WeakSet<HTMLElement>();

    const animateBars = (container: ParentNode) => {
      container
        .querySelectorAll<HTMLElement>("[data-field='bar']")
        .forEach((bar) => {
          if (animatedBars.has(bar)) return;

          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              bar.style.transform = "scaleX(var(--skill-level))";
              animatedBars.add(bar);
              observer.unobserve(bar);
            });
          });

          observer.observe(bar);
        });
    };

    const selectTab = (nextIndex: number) => {
      tabs.forEach((tab, index) => {
        const selected = index === nextIndex;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        tab.classList.toggle("bg-secondary-container", selected);
        tab.classList.toggle("text-on-secondary-container", selected);
        tab.classList.toggle("bg-surface-high", !selected);
        tab.classList.toggle("text-on-surface-variant", !selected);
      });

      panels.forEach((panel, index) => {
        panel.hidden = index !== nextIndex;
      });

      const selectedPanel = panels[nextIndex];
      if (selectedPanel) animateBars(selectedPanel);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectTab(index));
      tab.addEventListener("keydown", (event) => {
        let nextIndex: number | undefined;

        if (event.key === "ArrowRight" || event.key === "ArrowDown") {
          nextIndex = (index + 1) % tabs.length;
        } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
          nextIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (event.key === "Home") {
          nextIndex = 0;
        } else if (event.key === "End") {
          nextIndex = tabs.length - 1;
        }

        if (nextIndex === undefined) return;

        event.preventDefault();
        selectTab(nextIndex);
        tabs[nextIndex]?.focus();
      });
    });

    selectTab(0);
  }
</script>
