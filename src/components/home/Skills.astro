---
import { getSkills, stripHtml, type Skill } from "@/lib/wordpress";

const skills: Skill[] = await getSkills().catch(() => []);
const groupedSkills = skills.reduce<Record<string, Skill[]>>(
  (groups, skill) => {
    const category = stripHtml(skill.acf?.category ?? "") || "Otros";
    (groups[category] ??= []).push(skill);
    return groups;
  },
  {},
);
const skillGroups = Object.entries(groupedSkills);

const getLevel = (skill: Skill) => {
  const level = Number(skill.acf?.level ?? 0);
  return Number.isFinite(level) ? Math.min(100, Math.max(0, level)) : 0;
};
---

<section id="habilidades" class="py-24 lg:py-32 bg-surface-container">
  <div class="max-w-content mx-auto px-6 lg:px-10">
    <div class="flex items-center gap-4 mb-16 reveal">
      <span class="font-mono text-2xs text-primary uppercase tracking-widest"
        >02</span
      >
      <span class="block w-8 h-px bg-primary"></span>
      <h2
        class="font-headline text-3xl lg:text-4xl font-semibold text-on-surface"
      >
        Habilidades
      </h2>
    </div>

    {
      skillGroups.length > 0 ? (
        <>
          <div
            class="flex flex-wrap gap-2 mb-12 reveal"
            role="tablist"
            aria-label="Categorías de habilidades"
            data-skill-tablist
          >
            {skillGroups.map(([category], index) => (
              <button
                id={`skill-tab-${index}`}
                type="button"
                role="tab"
                aria-controls={`skill-panel-${index}`}
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? 0 : -1}
                data-skill-tab
                data-skill-index={index}
                class={`px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 ${
                  index === 0
                    ? "bg-secondary-container text-on-secondary-container"
                    : "bg-surface-high text-on-surface-variant hover:bg-surface-highest hover:text-on-surface"
                }`}
              >
                {category}
              </button>
            ))}
          </div>

          {skillGroups.map(([, categorySkills], groupIndex) => (
            <div
              id={`skill-panel-${groupIndex}`}
              role="tabpanel"
              aria-labelledby={`skill-tab-${groupIndex}`}
              data-skill-panel
              data-skill-index={groupIndex}
              hidden={groupIndex !== 0}
              class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"
            >
              {categorySkills.map((skill, skillIndex) => {
                const title =
                  stripHtml(skill.title?.rendered ?? "") || "Habilidad";
                const level = getLevel(skill);

                return (
                  <div
                    class="reveal group bg-surface-low hover:bg-surface-highest rounded-xl p-5 transition-all duration-300 ghost-border"
                    style={`animation-delay: ${skillIndex * 60}ms`}
                  >
                    <div class="flex items-center justify-between mb-3">
                      <span class="font-body text-sm font-medium text-on-surface">
                        {title}
                      </span>
                      <span class="font-mono text-xs text-primary">
                        {level}%
                      </span>
                    </div>
                    <div
                      class="h-1 bg-outline-variant/20 rounded-full overflow-hidden"
                      role="progressbar"
                      aria-label={`Nivel de ${title}`}
                      aria-valuemin="0"
                      aria-valuemax="100"
                      aria-valuenow={level}
                    >
                      <div
                        class="skill-bar h-full bg-primary rounded-full origin-left scale-x-0 transition-transform duration-700"
                        style={`--skill-level: ${level / 100}; transition-timing-function: var(--ease-expo);`}
                        data-skill-bar
                      />
                    </div>
                  </div>
                );
              })}
            </div>
          ))}
        </>
      ) : (
        <p class="rounded-lg border border-outline-variant/40 bg-surface-low px-4 py-3 text-sm text-on-surface-variant">
          No hay habilidades disponibles en este momento.
        </p>
      )
    }
  </div>
</section>

<script>
  const tabList = document.querySelector<HTMLElement>("[data-skill-tablist]");

  if (tabList) {
    const tabs = Array.from(
      tabList.querySelectorAll<HTMLButtonElement>("[data-skill-tab]"),
    );
    const panels = Array.from(
      document.querySelectorAll<HTMLElement>("[data-skill-panel]"),
    );
    const animatedBars = new WeakSet<HTMLElement>();

    const animateBars = (root: ParentNode = document) => {
      root.querySelectorAll<HTMLElement>("[data-skill-bar]").forEach((bar) => {
        if (animatedBars.has(bar)) return;

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            bar.style.transform = "scaleX(var(--skill-level))";
            animatedBars.add(bar);
            observer.unobserve(bar);
          });
        });

        observer.observe(bar);
      });
    };

    const selectTab = (nextIndex: number) => {
      tabs.forEach((tab, index) => {
        const selected = index === nextIndex;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        tab.classList.toggle("bg-secondary-container", selected);
        tab.classList.toggle("text-on-secondary-container", selected);
        tab.classList.toggle("bg-surface-high", !selected);
        tab.classList.toggle("text-on-surface-variant", !selected);
      });

      panels.forEach((panel, index) => {
        panel.hidden = index !== nextIndex;
      });

      const selectedPanel = panels[nextIndex];
      if (selectedPanel) animateBars(selectedPanel);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectTab(index));
      tab.addEventListener("keydown", (event) => {
        let nextIndex: number | undefined;

        if (event.key === "ArrowRight" || event.key === "ArrowDown") {
          nextIndex = (index + 1) % tabs.length;
        } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
          nextIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (event.key === "Home") {
          nextIndex = 0;
        } else if (event.key === "End") {
          nextIndex = tabs.length - 1;
        }

        if (nextIndex === undefined) return;

        event.preventDefault();
        selectTab(nextIndex);
        tabs[nextIndex]?.focus();
      });
    });

    selectTab(0);
  }
</script>
