<section id="blog" class="py-24 lg:py-32 bg-surface-container">
  <div class="max-w-content mx-auto px-6 lg:px-10">
    <div class="flex items-center justify-between mb-16 reveal">
      <div class="flex items-center gap-4">
        <span class="font-mono text-2xs text-primary uppercase tracking-widest"
          >05</span
        >
        <span class="block w-8 h-px bg-primary"></span>
        <h2
          class="font-headline text-3xl lg:text-4xl font-semibold text-on-surface"
        >
          Pensamiento Técnico
        </h2>
      </div>
      <a
        href="/blog"
        class="hidden sm:inline-flex items-center gap-2 text-sm text-on-surface-variant hover:text-primary transition-colors"
      >
        Ver todos
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>

    <div data-blog-preview aria-busy="true">
      <div data-view="loading">
        <p class="sr-only" role="status">Cargando artículos…</p>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3" aria-hidden="true">
          {
            [0, 1, 2].map((index) => (
              <div
                class:list={[
                  "rounded-xl overflow-hidden bg-surface-low ghost-border",
                  index > 0 && "hidden md:block",
                ]}
              >
                <div class="aspect-video bg-surface-high animate-pulse" />
                <div class="p-5 space-y-3">
                  <div class="h-3 w-1/3 rounded bg-surface-high animate-pulse" />
                  <div class="h-5 w-5/6 rounded bg-surface-high animate-pulse" />
                  <div class="h-4 w-full rounded bg-surface-high animate-pulse" />
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <p
        data-view="empty"
        hidden
        class="rounded-lg border border-outline-variant/40 bg-surface-low px-4 py-3 text-sm text-on-surface-variant"
      >
        No hay artículos disponibles en este momento.
      </p>

      <p
        data-view="error"
        hidden
        role="alert"
        class="rounded-lg border border-outline-variant/40 bg-surface-low px-4 py-3 text-sm text-on-surface-variant"
      >
        No se pudieron cargar los artículos. Intenta recargar la página.
      </p>

      <div
        data-view="ready"
        hidden
        data-blog-preview-list
        class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4 -mx-6 pl-12 pr-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:mx-0 md:grid md:grid-cols-3 md:gap-6 md:overflow-visible md:p-0"
      >
      </div>

      <template data-blog-preview-template>
        <a
          class="reveal group flex w-[calc(100%-1.5rem)] shrink-0 snap-start flex-col bg-surface-low rounded-xl overflow-hidden hover:bg-surface-highest hover:-translate-y-1 transition-all duration-300 ghost-border md:w-auto"
        >
          <div class="relative aspect-video bg-surface-container overflow-hidden">
            <img
              data-field="image"
              alt=""
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div
              data-field="placeholder"
              class="w-full h-full flex items-center justify-center text-primary/30"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-10 h-10"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"
                ></path>
              </svg>
            </div>
            <span class="absolute top-0 left-0 right-0 h-0.5 bg-primary"></span>
          </div>

          <div class="flex flex-col flex-1 p-5">
            <p
              data-field="date"
              class="font-mono text-2xs text-on-surface-variant uppercase tracking-wider mb-3"
            >
            </p>
            <h3
              data-field="title"
              class="font-headline text-lg font-semibold text-on-surface leading-snug mb-3 group-hover:text-primary transition-colors line-clamp-2"
            >
            </h3>
            <p
              data-field="excerpt"
              class="text-sm text-on-surface-variant leading-relaxed flex-1 line-clamp-3"
            >
            </p>
            <div
              class="mt-4 pt-4 flex items-center justify-between"
              style="border-top: 1px solid color-mix(in srgb, var(--outline-variant) 20%, transparent);"
            >
              <span class="text-xs font-medium text-primary">
                Leer artículo
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4 text-primary transition-transform duration-200 group-hover:translate-x-1"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </div>
          </div>
        </a>
      </template>
    </div>

    <div class="mt-10 text-center sm:hidden reveal">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm text-on-surface-variant hover:text-primary transition-colors"
      >
        Ver todos los artículos
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<script>
  import { applyImage, cloneTemplate, getField, setField, showView } from "@/lib/dom";
  import {
    formatPostDate,
    getFeaturedImage,
    getLatestPosts,
    getPostUrl,
    stripHtml,
    type WPPost,
  } from "@/lib/wordpress";

  const root = document.querySelector<HTMLElement>("[data-blog-preview]");
  if (root) {
    renderBlogPreview(root).catch((error) => {
      console.error(error);
      showView(root, "error");
    });
  }

  function createPostCard(root: HTMLElement, post: WPPost, index: number) {
    const card = cloneTemplate<HTMLAnchorElement>(
      root.querySelector("template[data-blog-preview-template]"),
    );
    const title = stripHtml(post.title?.rendered ?? "") || "Artículo";

    card.href = getPostUrl(post);
    card.style.animationDelay = `${index * 100}ms`;
    setField(card, "date", formatPostDate(post.date));
    setField(card, "title", title);
    setField(
      card,
      "excerpt",
      stripHtml(post.excerpt?.rendered ?? "") ||
        "Sin resumen disponible por el momento.",
    );

    const image = getFeaturedImage(post);
    const img = getField<HTMLImageElement>(card, "image");
    if (image && img) {
      applyImage(img, image, title, "(min-width: 1024px) 400px, (min-width: 768px) 33vw, 90vw");
      getField(card, "placeholder")?.remove();
    } else {
      img?.remove();
    }

    return card;
  }

  async function renderBlogPreview(root: HTMLElement) {
    const posts = await getLatestPosts(3);
    const list = root.querySelector<HTMLElement>("[data-blog-preview-list]");
    if (posts.length === 0 || !list) {
      showView(root, "empty");
      return;
    }

    list.replaceChildren(
      ...posts.map((post, index) => createPostCard(root, post, index)),
    );
    showView(root, "ready");
  }
</script>
