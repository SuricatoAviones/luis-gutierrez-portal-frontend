---
import {
  getFeaturedImage,
  getLatestPosts,
  stripHtml,
  type WPPost,
} from "@/lib/wordpress";
import { Picture } from "astro:assets";

const posts = await getLatestPosts(3).catch(() => [] as WPPost[]);

const formatDate = (value: string) => {
  const date = new Date(value);

  return Number.isNaN(date.getTime())
    ? ""
    : new Intl.DateTimeFormat("es-ES", {
        year: "numeric",
        month: "long",
        day: "numeric",
      }).format(date);
};
---

<section id="blog" class="py-24 lg:py-32 bg-surface-container">
  <div class="max-w-content mx-auto px-6 lg:px-10">
    <div class="flex items-center justify-between mb-16 reveal">
      <div class="flex items-center gap-4">
        <span class="font-mono text-2xs text-primary uppercase tracking-widest"
          >05</span
        >
        <span class="block w-8 h-px bg-primary"></span>
        <h2
          class="font-headline text-3xl lg:text-4xl font-semibold text-on-surface"
        >
          Pensamiento Técnico
        </h2>
      </div>
      <a
        href="/blog"
        class="hidden sm:inline-flex items-center gap-2 text-sm text-on-surface-variant hover:text-primary transition-colors"
      >
        Ver todos
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>

    {
      posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {posts.map((post, index) => {
            const title = stripHtml(post.title.rendered) || "Artículo";
            const excerpt = stripHtml(post.excerpt.rendered);
            const image = getFeaturedImage(post);

            return (
              <a
                href={`/blog/${encodeURIComponent(post.slug)}`}
                class="reveal group flex flex-col bg-surface-low rounded-xl overflow-hidden hover:bg-surface-highest hover:-translate-y-1 transition-all duration-300 ghost-border"
                style={`animation-delay: ${index * 100}ms`}
              >
                <div class="relative aspect-video bg-surface-container overflow-hidden">
                  {image ? (
                    <Picture
                      src={image}
                      alt={title}
                      inferSize={true}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                      formats={['avif', 'webp']}
                    />
                  ) : (
                    <div
                      class="w-full h-full flex items-center justify-center text-primary/30"
                      aria-hidden="true"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-10 h-10"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"
                        />
                      </svg>
                    </div>
                  )}
                  <span class="absolute top-0 left-0 right-0 h-0.5 bg-primary" />
                </div>

                <div class="flex flex-col flex-1 p-5">
                  <p class="font-mono text-2xs text-on-surface-variant uppercase tracking-wider mb-3">
                    {formatDate(post.date)}
                  </p>
                  <h3 class="font-headline text-lg font-semibold text-on-surface leading-snug mb-3 group-hover:text-primary transition-colors line-clamp-2">
                    {title}
                  </h3>
                  <p class="text-sm text-on-surface-variant leading-relaxed flex-1 line-clamp-3">
                    {excerpt || "Sin resumen disponible por el momento."}
                  </p>
                  <div
                    class="mt-4 pt-4 flex items-center justify-between"
                    style="border-top: 1px solid color-mix(in srgb, var(--outline-variant) 20%, transparent);"
                  >
                    <span class="text-xs font-medium text-primary">
                      Leer artículo
                    </span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-4 h-4 text-primary transition-transform duration-200 group-hover:translate-x-1"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                      stroke="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                      />
                    </svg>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <p class="rounded-lg border border-outline-variant/40 bg-surface-low px-4 py-3 text-sm text-on-surface-variant">
          No hay artículos disponibles en este momento.
        </p>
      )
    }

    <div class="mt-10 text-center sm:hidden reveal">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm text-on-surface-variant hover:text-primary transition-colors"
      >
        Ver todos los artículos
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
