---
/**
 * Listado del blog renderizado en el navegador. La página se lee de `?page=N`
 * y se consulta directamente a la API de WordPress.
 */
interface Props {
  postsPerPage?: number;
}

const { postsPerPage = 9 } = Astro.props;
---

<div
  class="max-w-content mx-auto px-6 lg:px-10 py-16"
  data-blog-list
  data-posts-per-page={postsPerPage}
  aria-busy="true"
>
  <div data-view="loading">
    <p class="sr-only" role="status">Cargando artículos…</p>
    <div aria-hidden="true">
      <div
        class="grid grid-cols-1 lg:grid-cols-2 rounded-xl overflow-hidden bg-surface-low ghost-border"
      >
        <div class="aspect-video bg-surface-container animate-pulse"></div>
        <div class="p-8 lg:p-10 space-y-4">
          <div class="h-3 w-1/4 rounded bg-surface-high animate-pulse"></div>
          <div class="h-8 w-5/6 rounded bg-surface-high animate-pulse"></div>
          <div class="h-4 w-full rounded bg-surface-high animate-pulse"></div>
          <div class="h-4 w-2/3 rounded bg-surface-high animate-pulse"></div>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-16">
        {
          [0, 1, 2].map((index) => (
            <div
              class:list={[
                "rounded-xl overflow-hidden bg-surface-low ghost-border",
                index === 1 && "hidden md:block",
                index === 2 && "hidden lg:block",
              ]}
            >
              <div class="aspect-video bg-surface-container animate-pulse" />
              <div class="p-5 space-y-3">
                <div class="h-3 w-1/3 rounded bg-surface-high animate-pulse" />
                <div class="h-5 w-5/6 rounded bg-surface-high animate-pulse" />
                <div class="h-4 w-full rounded bg-surface-high animate-pulse" />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div data-view="empty" hidden class="text-center py-20">
    <p class="font-headline text-2xl text-on-surface-variant">Próximamente...</p>
    <p class="text-sm text-on-surface-variant mt-2">
      Aún no hay artículos disponibles.
    </p>
  </div>

  <div data-view="not-found" hidden class="text-center py-20">
    <p class="font-headline text-2xl text-on-surface-variant">
      Esta página del blog no existe
    </p>
    <a
      href="/blog/"
      class="inline-flex mt-6 items-center gap-2 text-sm text-primary hover:underline"
    >
      Ir a la primera página
    </a>
  </div>

  <div data-view="error" hidden role="alert" class="text-center py-20">
    <p class="font-headline text-2xl text-on-surface-variant">
      No se pudieron cargar los artículos
    </p>
    <p class="text-sm text-on-surface-variant mt-2">
      Revisa tu conexión e intenta recargar la página.
    </p>
  </div>

  <div data-view="ready" hidden>
    <div data-blog-featured></div>
    <div
      data-blog-grid
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-16"
    >
    </div>

    <nav
      data-blog-pagination
      class="mt-16 flex items-center justify-center gap-4"
      aria-label="Paginación del blog"
    >
      <a
        data-field="prev"
        rel="prev"
        class="px-5 py-2 text-sm text-on-surface-variant hover:text-on-surface rounded-full transition-colors ghost-border"
      >
        <span aria-hidden="true">← </span>Anterior
      </a>
      <span
        data-field="current"
        class="font-mono text-sm text-on-surface-variant"
        aria-current="page"></span>
      <a
        data-field="next"
        rel="next"
        class="px-5 py-2 text-sm text-on-surface-variant hover:text-on-surface rounded-full transition-colors ghost-border"
      >
        Siguiente<span aria-hidden="true"> →</span>
      </a>
    </nav>
  </div>

  <template data-featured-template>
    <a
      class="group grid grid-cols-1 lg:grid-cols-2 gap-0 bg-surface-low rounded-xl overflow-hidden hover:bg-surface-highest hover:shadow-xl transition-all duration-300 hover:-translate-y-1 ghost-border"
    >
      <div
        class="relative aspect-video lg:aspect-auto bg-surface-container overflow-hidden"
      >
        <img
          data-field="image"
          alt=""
          decoding="async"
          fetchpriority="high"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div
          data-field="placeholder"
          class="w-full h-full flex items-center justify-center"
          aria-hidden="true"
        >
          <span
            data-field="initial"
            class="font-headline text-7xl font-bold text-primary/20"></span>
        </div>
        <span
          class="absolute top-4 left-4 font-mono text-2xs uppercase tracking-wider bg-primary text-on-primary px-3 py-1 rounded-full"
        >
          Destacado
        </span>
      </div>

      <div class="p-8 lg:p-10 flex flex-col justify-center">
        <p
          data-field="date"
          class="font-mono text-2xs text-on-surface-variant uppercase tracking-wider mb-4"
        >
        </p>
        <h2
          data-field="title"
          class="font-headline text-2xl lg:text-3xl font-semibold text-on-surface leading-snug mb-4 group-hover:text-primary transition-colors"
        >
        </h2>
        <p
          data-field="excerpt"
          class="text-on-surface-variant leading-relaxed line-clamp-3 mb-6"
        >
        </p>
        <span
          class="inline-flex items-center gap-2 text-sm font-medium text-primary"
        >
          Leer artículo
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </span>
      </div>
    </a>
  </template>

  <template data-card-template>
    <a
      class="reveal group flex flex-col bg-surface-low rounded-xl overflow-hidden hover:bg-surface-highest hover:-translate-y-1 transition-all duration-300 ghost-border"
    >
      <div class="relative aspect-video bg-surface-container overflow-hidden">
        <img
          data-field="image"
          alt=""
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div
          data-field="placeholder"
          class="w-full h-full flex items-center justify-center"
          aria-hidden="true"
        >
          <span
            data-field="initial"
            class="font-headline text-4xl font-bold text-primary/20"></span>
        </div>
      </div>

      <div class="flex flex-col flex-1 p-5">
        <p
          data-field="date"
          class="font-mono text-2xs text-on-surface-variant uppercase tracking-wider mb-3"
        >
        </p>
        <h3
          data-field="title"
          class="font-headline text-lg font-semibold text-on-surface leading-snug mb-3 group-hover:text-primary transition-colors line-clamp-2"
        >
        </h3>
        <p
          data-field="excerpt"
          class="text-sm text-on-surface-variant leading-relaxed flex-1 line-clamp-3"
        >
        </p>
        <div
          class="mt-4 pt-4 flex items-center justify-between"
          style="border-top: 1px solid color-mix(in srgb, var(--outline-variant) 20%, transparent);"
        >
          <span class="text-xs font-medium text-primary"> Leer artículo </span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 text-primary transition-transform duration-200 group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </div>
      </div>
    </a>
  </template>
</div>

<script>
  import { applyImage, cloneTemplate, getField, setField, showView } from "@/lib/dom";
  import {
    WPApiError,
    formatPostDate,
    getFeaturedImage,
    getPostUrl,
    getPosts,
    stripHtml,
    type PostsPage,
    type WPPost,
  } from "@/lib/wordpress";

  const root = document.querySelector<HTMLElement>("[data-blog-list]");
  if (root) {
    renderBlogList(root).catch((error) => {
      console.error(error);
      showView(root, "error");
    });
  }

  function getPageUrl(page: number): string {
    return page <= 1 ? "/blog/" : `/blog/?page=${page}`;
  }

  function readCurrentPage(): number {
    const page = Number(new URLSearchParams(window.location.search).get("page"));
    return Number.isInteger(page) && page > 1 ? page : 1;
  }

  function fillPost(
    element: HTMLElement,
    post: WPPost,
    imageSizes: string,
  ): void {
    const title = stripHtml(post.title?.rendered ?? "") || "Artículo";

    if (element instanceof HTMLAnchorElement) element.href = getPostUrl(post);
    setField(element, "date", formatPostDate(post.date));
    setField(element, "title", title);
    setField(
      element,
      "excerpt",
      stripHtml(post.excerpt?.rendered ?? "") ||
        "Sin resumen disponible por el momento.",
    );

    const image = getFeaturedImage(post);
    const img = getField<HTMLImageElement>(element, "image");
    if (image && img) {
      applyImage(img, image, title, imageSizes);
      getField(element, "placeholder")?.remove();
    } else {
      img?.remove();
      setField(element, "initial", title.charAt(0).toUpperCase());
    }
  }

  function updatePageMeta(page: number): void {
    if (page <= 1) return;

    document.title = `Página ${page} · Blog de Luis Angel Gutierrez`;
    // El canonical generado en build ya apunta al dominio público del sitio.
    const canonical = document.querySelector('link[rel="canonical"]');
    const url = new URL(
      getPageUrl(page),
      canonical?.getAttribute("href") ?? window.location.origin,
    ).href;
    canonical?.setAttribute("href", url);
    document
      .querySelector('meta[property="og:url"]')
      ?.setAttribute("content", url);
  }

  function renderPagination(
    root: HTMLElement,
    currentPage: number,
    totalPages: number,
  ): void {
    const nav = root.querySelector<HTMLElement>("[data-blog-pagination]");
    if (!nav) return;

    if (totalPages <= 1) {
      nav.remove();
      return;
    }

    setField(nav, "current", `Página ${currentPage} de ${totalPages}`);

    const prev = getField<HTMLAnchorElement>(nav, "prev");
    if (prev && currentPage > 1) prev.href = getPageUrl(currentPage - 1);
    else prev?.remove();

    const next = getField<HTMLAnchorElement>(nav, "next");
    if (next && currentPage < totalPages) next.href = getPageUrl(currentPage + 1);
    else next?.remove();
  }

  function showNotFound(root: HTMLElement): void {
    document
      .querySelector('meta[name="robots"]')
      ?.setAttribute("content", "noindex,follow");
    showView(root, "not-found");
  }

  async function renderBlogList(root: HTMLElement) {
    const perPage = Number(root.dataset.postsPerPage) || 9;
    const currentPage = readCurrentPage();
    let result: PostsPage;

    try {
      result = await getPosts(perPage, currentPage);
    } catch (error) {
      // WordPress responde 400 cuando la página pedida supera el total.
      if (error instanceof WPApiError && error.status === 400 && currentPage > 1) {
        showNotFound(root);
      } else {
        console.error(error);
        showView(root, "error");
      }
      return;
    }

    const [featuredPost, ...otherPosts] = result.posts;
    if (!featuredPost) {
      if (currentPage > 1) showNotFound(root);
      else showView(root, "empty");
      return;
    }

    const featured = cloneTemplate(
      root.querySelector("template[data-featured-template]"),
    );
    fillPost(featured, featuredPost, "(min-width: 1024px) 50vw, 100vw");
    root.querySelector("[data-blog-featured]")?.replaceChildren(featured);

    const grid = root.querySelector<HTMLElement>("[data-blog-grid]");
    if (grid && otherPosts.length > 0) {
      grid.replaceChildren(
        ...otherPosts.map((post, index) => {
          const card = cloneTemplate(root.querySelector("template[data-card-template]"));
          card.style.animationDelay = `${index * 100}ms`;
          fillPost(
            card,
            post,
            "(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw",
          );
          return card;
        }),
      );
    } else {
      grid?.remove();
    }

    renderPagination(root, currentPage, result.totalPages);
    updatePageMeta(currentPage);
    showView(root, "ready");
  }
</script>
