# ─────────────────────────────────────────────
# Archivo Luis Gutierrez — optimización de caché
# Funciona en Apache y LiteSpeed (cPanel)
# ─────────────────────────────────────────────

# Rutas del blog: los artículos se cargan en el navegador desde WordPress,
# así que todas las URLs /blog/<slug> usan la misma plantilla estática.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Paginación anterior (/blog/page/N) → /blog/?page=N
  RewriteRule ^blog/page/([0-9]+)/?$ /blog/?page=$1 [R=301,L]

  # /blog/<slug> → /blog/post/index.html (la URL visible no cambia)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^blog/([^/]+)/?$ blog/post/index.html [L]
</IfModule>

# Expiración por tipo MIME
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Cache-Control
<IfModule mod_headers.c>
  # HTML va sin caché (siempre revalidar)
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Assets hasheados por Astro (/_astro/) e imágenes: 1 año, inmutables
  <FilesMatch "\.(avif|webp|png|jpe?g|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(woff2?|ttf|otf|eot|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Seguridad básica
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml image/svg+xml application/json
</IfModule>